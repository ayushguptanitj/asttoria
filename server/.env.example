# ─── Server ─────────────────────────────────────────────
PORT=3001

# ─── MongoDB Atlas ──────────────────────────────────────
# Get this from: https://cloud.mongodb.com -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/asttoria?retryWrites=true&w=majority

# ─── JWT ────────────────────────────────────────────────
# Use a long, random string in production (e.g. openssl rand -base64 64)
JWT_SECRET=replace_with_a_strong_random_secret

# ─── Admin Credentials ──────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
